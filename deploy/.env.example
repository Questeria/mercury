# Copy to `.env` (cd deploy && cp .env.example .env) and fill in a real seed before `docker compose up`.
# The .env file is git-ignored — never commit a real seed.

# Stable Key-Transparency VRF key (64 hex chars). Generate one ONCE and keep it:
#   openssl rand -hex 32
# If this changes, the KT directory identity changes, so keep it stable across restarts/redeploys.
MERCURY_KT_VRF_SEED=
