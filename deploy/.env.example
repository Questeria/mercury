# Copy to `.env` (cd deploy && cp .env.example .env) and fill in a real seed before `docker compose up`.
# The .env file is git-ignored — never commit a real seed.

# Stable Key-Transparency VRF key (64 hex chars). Generate one ONCE and keep it:
#   openssl rand -hex 32
# If this changes, the KT directory identity changes, so keep it stable across restarts/redeploys.
MERCURY_KT_VRF_SEED=

# OPTIONAL: split-view (equivocation) detection. Leave BOTH blank to disable (the default).
# To enable, pin the public keys of INDEPENDENT witness operators + a DISTINCT auditor, then have them
# run `mercury-kt-witness` against this relay (see docs/WITNESSING.md + docs/WITNESS-OPERATORS.md).
# A witness generates its keypair with `mercury-kt-witness keygen` and sends you only its PUBLIC key.
#
#   MERCURY_KT_WITNESSES = "0:<64-hex-pubkey>,1:<64-hex-pubkey>,..."  (order = the canonical witness_index)
#   MERCURY_KT_AUDITOR   = "<64-hex-pubkey>"                          (must differ from every witness key)
#
# Real protection requires >= 2 GENUINELY INDEPENDENT operators actually deployed + submitting — the
# relay only accepts + serves their cosignatures; it cannot manufacture the independence.
MERCURY_KT_WITNESSES=
MERCURY_KT_AUDITOR=
